#!name= Google重定向
#!desc= CN与HK谷歌重定向
#!category=

[URL Rewrite]
# 匹配带和不带 www 的 .cn 域名
^https?:\/\/(www\.)?g(oogle)?\.cn https://www.google.com 307
# 匹配带和不带 www 的 .hk 域名
^https?:\/\/(www\.)?google\.com\.hk https://www.google.com 307

[MITM]
hostname = %APPEND% www.g.cn, www.google.cn, g.cn, google.cn, google.com.hk, www.google.com.hk
