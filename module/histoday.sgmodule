#!name= 历史上的今天
#!desc= Histoday面板，https://lishishangdejintian.bmcx.com
#!homepage = https://yfamilys.com/sgmodule/histoday.sgmodule
#!arguments= count:8,update-interval:12
#!arguments-desc= count: 事件的显示条数\n\nupdate-interval: 面板刷新时间

[Script]
Histoday= type=generic,script-path=https://raw.githubusercontent.com/deezertidal/Surge_Module/master/files/histoday.js,argument=icon=calendar&color=#bf2f24&count={{{count}}}

[Panel]
Histoday=script-name=Histoday,update-interval={{{update-interval}}}
