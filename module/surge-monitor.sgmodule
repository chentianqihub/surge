#!name= Surge Prometheus Metrics
#!desc= 展示 Surge 运行时的 Prometheus 文本格式公开统计信息
#!arguments= key:123
#!arguments-desc= key:Surge HTTP API 密钥

[Panel]
SurgeMonitor = title="Surge Monitor",content="正在获取数据...",style=info,script-name=surge-monitor,update-interval=10

[Script]
surge-monitor = type=generic,script-path=https://raw.githubusercontent.com/chentianqihub/surge/main/scripts/surge-monitor.js
