#!name= WPS签到
#!desc= WPS Office 每日签到 + 福利中心多项任务,送 WPS 积分与超级会员时长
#!url= https://github.com/MaYIHEI/paperclip/tree/main/app/wps
#!arguments= 
#!arguments-desc=

[MITM]
hostname = %APPEND% personal-act.wps.cn

[Script]
WPS Cookie = type=http-request,pattern=^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js
WPS签到 = type=cron,cronexp=0 10 * * *,timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js
